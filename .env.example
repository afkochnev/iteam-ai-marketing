APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=iteam_access_token
COOKIE_SECURE=false
SELF_REGISTRATION_ENABLED=false
RATE_LIMIT_REGISTRATION_PER_MINUTE=5
RATE_LIMIT_PASSWORD_CHANGE_PER_MINUTE=5
DATABASE_URL=postgresql+asyncpg://iteam:iteam@postgres:5432/iteam
TEST_DATABASE_URL=postgresql+asyncpg://iteam:iteam@postgres:5432/iteam_test
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/15
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_VECTOR_STORE_ID=
OPENAI_AGENTS_DISABLE_TRACING=1
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
APP_VERSION=0.1.0
BUILD_SHA=
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_MAX_TURNS=8
SMM_AGENT_MAX_TURNS=3
AGENT_PROVIDER_REQUEST_TIMEOUT_SECONDS=60
SMM_FINAL_PROVIDER_TIMEOUT_SECONDS=120
AGENT_PROVIDER_MAX_RETRIES=0
AGENT_MAX_RETRIES=3
AGENT_OUTPUT_REPAIR_ATTEMPTS=2
SMM_AGENT_OUTPUT_REPAIR_ATTEMPTS=1
AGENT_RETRY_BACKOFF_SECONDS=5
TASK_STUCK_AFTER_SECONDS=600
TASK_DISPATCH_INTERVAL_SECONDS=10
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_ACTIONS_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=10
KNOWLEDGE_MAX_UPLOAD_MB=25
MAX_UPLOAD_SIZE_MB=25
KNOWLEDGE_INDEX_TIMEOUT_SECONDS=300
KNOWLEDGE_INDEX_POLL_INTERVAL_SECONDS=2
POSTGRES_DB=iteam
POSTGRES_USER=iteam
POSTGRES_PASSWORD=iteam
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=iTeam Administrator
TELEGRAM_PUBLISHING_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
PUBLICATION_MAX_RETRIES=3
PUBLICATION_PUBLISHING_STALE_SECONDS=600
VK_PUBLISHING_ENABLED=false
VK_ACCESS_TOKEN=
VK_OWNER_ID=
VK_API_VERSION=5.199
VK_REQUEST_TIMEOUT_SECONDS=30
METRICS_SYNC_ENABLED=false
METRICS_SYNC_INTERVAL_SECONDS=3600
METRICS_LOOKBACK_DAYS=30

# Automatic due dispatch never catches up older slots; human decision is required.
PUBLICATION_AUTO_DISPATCH_MAX_LATENESS_SECONDS=3600

# Read-only Director chat context; full history remains in PostgreSQL.
DIRECTOR_CHAT_RECENT_MESSAGES=12
DIRECTOR_CHAT_CONTEXT_MAX_CHARS=24000
DIRECTOR_CHAT_DIGEST_MAX_CHARS=8000
